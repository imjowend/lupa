# Variables de entorno de Lupa. Solo nombres: nunca pongas valores reales acá.
# Las cuatro claves de proveedores salen de specs/ROADMAP.md (secrets de GitHub).
# El resto son nombres propuestos a partir de docs/DESIGN.md; se confirman en T000.5.

# Modelos y fuentes
OPENAI_API_KEY=
GOOGLE_API_KEY=
JINA_API_KEY=
FIRECRAWL_API_KEY=

# API de X (opcional, no activar todavía)
X_API_BEARER_TOKEN=

# Base de datos: pendiente del ADR 0001 (SQLite o Postgres). No fijar todavía.
DATABASE_URL=

# Qdrant (vectores)
QDRANT_URL=

# Cloudflare: Turnstile y R2 (backups y snapshots)
TURNSTILE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# API: orígenes CORS permitidos, proxy de confianza y kill switch de gasto (USD por día)
ALLOWED_ORIGINS=
TRUSTED_PROXY=
DAILY_BUDGET_USD=
